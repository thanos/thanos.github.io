---
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';
import { formatAuthors } from '../lib/authors';
import { loadSiteProfile, personId, withSiteBase } from '../lib/site-identity';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  authors?: string[];
  canonicalPath?: string;
  /** When set, shows a link back to the series index. */
  seriesLink?: { slug: string; title: string };
  kind?: 'article' | 'note' | 'series';
}

const {
  title,
  description,
  date,
  tags,
  authors = [],
  seriesLink,
  kind = 'article',
} = Astro.props;
const byline = formatAuthors(authors);
const base = import.meta.env.BASE_URL;
const profile = loadSiteProfile();
const site = Astro.site ?? new URL(profile.web.url);
const canonicalPath = Astro.props.canonicalPath ?? Astro.url.pathname;
const formatted = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);

const section =
  kind === 'note' ? { name: 'Notes', path: 'notes/' } : kind === 'series' ? { name: 'Series', path: 'series/' } : { name: 'Articles', path: 'articles/' };

const jsonLd = [
  {
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: date.toISOString(),
    dateModified: date.toISOString(),
    inLanguage: 'en',
    keywords: tags,
    image: new URL(profile.web.image.replace(/^\//, ''), site).href,
    author: { '@id': personId(site.href) },
    publisher: { '@id': personId(site.href) },
    mainEntityOfPage: new URL(canonicalPath.replace(/^\//, ''), site).href,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(base, site).href },
      {
        '@type': 'ListItem',
        position: 2,
        name: section.name,
        item: new URL(section.path, site).href,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: title,
        item: new URL(canonicalPath.replace(/^\//, ''), site).href,
      },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  authors={authors}
  jsonLd={jsonLd}
  ogType="article"
  publishedTime={date}
  tags={tags}
>
  <nav
    class="mx-auto flex max-w-3xl flex-wrap items-center gap-x-4 gap-y-1 px-4 py-6 text-sm text-neutral-600"
    aria-label="Breadcrumb"
  >
    <a href={base} class="underline-offset-4 hover:text-neutral-900 hover:underline">Home</a>
    <span aria-hidden="true">/</span>
    <a
      href={withSiteBase(section.path, base)}
      class="underline-offset-4 hover:text-neutral-900 hover:underline">{section.name}</a
    >
    {
      seriesLink && (
        <>
          <span aria-hidden="true">/</span>
          <a
            href={withSiteBase(`series/${seriesLink.slug}/`, base)}
            class="underline-offset-4 hover:text-neutral-900 hover:underline"
          >
            {seriesLink.title}
          </a>
        </>
      )
    }
  </nav>
  <article class="mx-auto max-w-3xl px-4 pb-16" itemscope itemtype="https://schema.org/BlogPosting">
    <header class="mb-10 border-b border-neutral-200 pb-8">
      <h1 class="text-3xl font-semibold tracking-tight text-neutral-950 md:text-4xl" itemprop="headline">
        {title}
      </h1>
      <p class="mt-2 text-neutral-600">
        <time datetime={date.toISOString()} itemprop="datePublished">{formatted}</time>
      </p>
      {tags.length > 0 && (
        <div class="mt-4">
          <TagList tags={tags} />
        </div>
      )}
      {byline && (
        <p class="mt-4 text-sm text-neutral-600">
          <span class="text-neutral-500">By</span> <span itemprop="author">{byline}</span>
        </p>
      )}
    </header>
    <div class="article-body" itemprop="articleBody">
      <slot />
    </div>
  </article>
</BaseLayout>
