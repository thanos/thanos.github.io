---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import {
  loadSiteProfile,
  pageTitle,
  graphJsonLd,
  absoluteUrl,
} from '../lib/site-identity';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  authors?: string[];
  jsonLd?: unknown;
  ogType?: 'website' | 'article' | 'profile';
  publishedTime?: Date;
  tags?: string[];
  robots?: string;
}

const profile = loadSiteProfile();
const {
  title,
  description,
  canonicalPath,
  authors = [profile.name],
  jsonLd,
  ogType = 'website',
  publishedTime,
  tags = [],
  robots = 'index, follow, max-image-preview:large',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const rawPath = canonicalPath ?? Astro.url.pathname;
const pathname = rawPath.startsWith(base) ? rawPath : `${base}${rawPath.replace(/^\//, '')}`;
const site = Astro.site ?? new URL(profile.web.url);
const canonical = new URL(pathname, site);
const fullTitle = pageTitle(title, profile.name);
const image = absoluteUrl(profile.web.image, site.href);
const jsonLdText = JSON.stringify(graphJsonLd(jsonLd ? [jsonLd] : [], site.href)).replace(
  /</g,
  '\\u003c'
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="7tgf5RWO1pdW8ERKmL08T19NfK_Dayn_pZDZv8j4UDE" />
    <meta name="description" content={description} />
    <meta name="author" content={authors.join(', ')} />
    <meta name="robots" content={robots} />
    {tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
    <link rel="canonical" href={canonical.href} />
    <link rel="author" href={new URL('about/', site).href} />
    <link rel="sitemap" type="application/xml" href={new URL('sitemap-index.xml', site).href} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${profile.name} articles`}
      href={new URL('rss.xml', site).href}
    />
    <link rel="icon" href={profile.web.image} type="image/jpeg" />
    <link rel="apple-touch-icon" href={profile.web.image} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={`Portrait of ${profile.name}`} />
    <meta property="og:locale" content="en_US" />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {
      ogType === 'article' &&
        authors.map((name) => <meta property="article:author" content={name} />)
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {profile.web.sameAs.map((link) => <link rel="me" href={link.url} />)}
    <title>{fullTitle}</title>
    <script is:inline type="application/ld+json" set:html={jsonLdText} />
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-neutral-900 antialiased">
    <div class="flex-1">
      <slot />
    </div>
    <SiteFooter />
  </body>
</html>
