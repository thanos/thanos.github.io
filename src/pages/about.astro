---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadSiteProfile, collapse, personId, withSiteBase } from '../lib/site-identity';
import { loadJobs, formatWhen } from '../lib/resume-experiences';

const profile = loadSiteProfile();
const base = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL(profile.web.url);
const currentJob = loadJobs().find((j) => j.current) ?? loadJobs()[0];
const photo = withSiteBase(profile.web.image.replace(/^\//, ''), base);
const bio = collapse(profile.web.bio);
---

<BaseLayout
  title={`About ${profile.name}`}
  description={bio}
  canonicalPath="/about/"
  authors={[profile.name]}
  ogType="profile"
  jsonLd={{
    '@type': 'AboutPage',
    name: `About ${profile.name}`,
    description: bio,
    url: new URL('about/', site).href,
    mainEntity: { '@id': personId(site.href) },
  }}
>
  <div class="mx-auto max-w-3xl px-4 py-12 md:py-16">
    <nav class="text-sm text-neutral-600" aria-label="Breadcrumb">
      <a href={base} class="underline-offset-4 hover:text-neutral-900 hover:underline">Home</a>
    </nav>

    <header class="mt-8 flex items-start gap-5">
      <img
        src={photo}
        alt={`Portrait of ${profile.name}`}
        width="96"
        height="96"
        class="h-20 w-20 shrink-0 object-cover md:h-24 md:w-24"
      />
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-neutral-950 md:text-4xl">
          {profile.name}
        </h1>
        <p class="mt-2 text-neutral-700">{profile.web.headline}</p>
        <p class="mt-1 text-sm text-neutral-500">
          {profile.web.works_for}
          {currentJob?.when ? ` · ${formatWhen(currentJob.when)}` : ''}
          {` · ${profile.web.location}`}
        </p>
      </div>
    </header>

    <article class="mt-8 space-y-6 text-neutral-800 leading-relaxed">
      <p>{bio}</p>
      <p>
        This site is the canonical public record of that work: a{' '}
        <a href={`${base}portfolio/`} class="font-medium text-neutral-900 underline underline-offset-4"
          >portfolio</a
        >{' '}
        of roles and systems, a{' '}
        <a href={`${base}timeline/`} class="font-medium text-neutral-900 underline underline-offset-4"
          >career timeline</a
        >,{' '}
        <a href={`${base}articles/`} class="font-medium text-neutral-900 underline underline-offset-4"
          >articles</a
        >, and a{' '}
        <a href={`${base}resume/`} class="font-medium text-neutral-900 underline underline-offset-4"
          >résumé</a
        >.
      </p>

      <section>
        <h2 class="text-lg font-semibold text-neutral-950">Now</h2>
        <p class="mt-2">
          {currentJob?.summary ??
            'Technical leadership for Finance IT and Capital Markets platforms — architecture, AI/ML adoption, post-trade, supervision, and shared services.'}
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-neutral-950">Writes and builds</h2>
        <p class="mt-2">
          {profile.web.knowsAbout.join(', ')}.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-neutral-950">Elsewhere</h2>
        <ul class="mt-2 space-y-1">
          {
            profile.web.sameAs.map((link) => (
              <li>
                <a
                  href={link.url}
                  rel="me noopener noreferrer"
                  class="font-medium text-neutral-900 underline underline-offset-4"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={`mailto:${profile.email}`} class="font-medium text-neutral-900 underline underline-offset-4">
              {profile.email}
            </a>
          </li>
        </ul>
      </section>
    </article>
  </div>
</BaseLayout>
