---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeIntro from '../../components/HomeIntro.astro';
import HomeArticleFeed from '../../components/HomeArticleFeed.astro';
import { HOME_PAGE_SIZE } from '../../constants';
import { getSortedHomeArticles } from '../../lib/home-articles';

export async function getStaticPaths() {
  const sorted = await getSortedHomeArticles();
  const totalPages = Math.max(1, Math.ceil(sorted.length / HOME_PAGE_SIZE));
  if (totalPages <= 1) {
    return [];
  }
  const paths: {
    params: { page: string };
    props: { currentPage: number; articles: typeof sorted };
  }[] = [];
  for (let p = 2; p <= totalPages; p++) {
    paths.push({
      params: { page: String(p) },
      props: {
        currentPage: p,
        articles: sorted,
      },
    });
  }
  return paths;
}

interface Props {
  currentPage: number;
  articles: Awaited<ReturnType<typeof getSortedHomeArticles>>;
}

const { currentPage, articles } = Astro.props;
---

<BaseLayout
  title={`Thanos Vassilakis — page ${currentPage}`}
  description="Writing on software, systems, and notes from the field."
  canonicalPath={`/page/${currentPage}/`}
>
  <div class="mx-auto max-w-3xl px-4 py-12 md:py-16">
    <HomeIntro />
    <HomeArticleFeed articles={articles} currentPage={currentPage} />
  </div>
</BaseLayout>
